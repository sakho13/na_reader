{
  "name": "na_reader",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "esbuild content_scripts/content_script.ts popup/popup.ts --bundle --format=iife --target=chrome120 --outbase=. --outdir=dist --sourcemap",
    "build:release": "npm run prebuild && esbuild content_scripts/content_script.ts popup/popup.ts --bundle --format=iife --target=chrome120 --outbase=. --outdir=dist --minify",
    "prepack": "node -e \"require('fs').rmSync('na_reader.zip',{force:true})\" && npm run build:release",
    "pack": "7z a na_reader.zip manifest.json dist icons popup/popup.html popup/popup.css content_scripts/content_script.css"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chrome": "0.0.227",
    "@types/node": "26.6.11",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "8.10.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "2.0.0",
    "jsdom": "31.0.1",
    "prettier": "2.8.8",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
