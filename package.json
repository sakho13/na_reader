    "eslint-plugin-unused-imports": "2.0.0",
    "jsdom": "31.0.1",
    "prettier": "2.8.8",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "@types/chrome": "0.0.227",
